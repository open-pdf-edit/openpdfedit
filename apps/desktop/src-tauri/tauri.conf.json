{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPdfEdit",
  "version": "0.1.11",
  "identifier": "com.openpdfedit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenPdfEdit",
        "width": 1100,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxOUNDOTJFNDM2MjcwNkMKUldSc2NHSkRMc21jTWVhcmxSMzNFTWFVQ3FmQ1Z1NjEzMnBGMTVURHFhSEJqWXk4U3RHL3dIbEwK",
      "endpoints": [
        "https://github.com/open-pdf-edit/openpdfedit/releases/latest/download/latest.json"
      ]
    }
  }
}
