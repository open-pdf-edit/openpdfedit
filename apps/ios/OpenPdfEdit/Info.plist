<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>OpenPdfEdit</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Everything renders and saves on the device, so there is no
	     encryption here beyond the HTTPS the OS provides. Declaring it
	     removes the export-compliance question from every upload; leaving
	     it out makes someone answer it by hand each time, and answer it
	     wrong eventually. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- "Open in OpenPdfEdit" from Files, Mail and any share sheet.
	     Editor rather than Viewer: this app changes documents, and
	     claiming otherwise puts it below every real editor in the list
	     iOS offers. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<!-- False on purpose. In-place editing would mean writing back to the
	     file the customer picked, and this editor saves by producing a new
	     document — the web app it wraps has no filesystem to write into.
	     Set true, iOS hands over a security-scoped original and every save
	     silently goes somewhere else. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>

	<!-- The sign-in callback. Deliberately not the scheme the bundled web
	     app is served from: two things claiming one scheme is a puzzle for
	     whoever debugs it next. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.openpdfedit.app.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openpdfedit-auth</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
