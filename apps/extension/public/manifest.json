{
  "manifest_version": 3,
  "name": "OpenPdfEdit",
  "version": "0.1.2",
  "description": "Edit, merge, and compare PDFs entirely in your browser — 100% local, nothing ever uploaded. Annotate, fill forms, sign, redact, and reorganize pages with no account required.",
  "minimum_chrome_version": "103",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
